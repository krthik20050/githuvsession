---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getCatalogSummary } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const catalogSummary = await getCatalogSummary(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div
      class="mb-8 grid gap-4 sm:grid-cols-2"
      data-testid="catalog-summary"
      role="status"
      aria-live="polite"
      aria-label="Catalog summary"
    >
      <div
        class="rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg"
        data-testid="catalog-summary-total"
      >
        <p class="text-sm font-medium uppercase tracking-[0.12em] text-slate-300">Total games</p>
        <p class="mt-3 text-3xl font-semibold text-slate-100" data-testid="catalog-summary-total-value">
          {catalogSummary.totalGames}
        </p>
      </div>

      <div
        class="rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg"
        data-testid="catalog-summary-rating"
      >
        <p class="text-sm font-medium uppercase tracking-[0.12em] text-slate-300">Average rating</p>
        <p class="mt-3 text-3xl font-semibold text-slate-100" data-testid="catalog-summary-rating-value">
          {catalogSummary.averageRating === null ? 'N/A' : `${catalogSummary.averageRating.toFixed(1)}/5`}
        </p>
        <p class="mt-2 text-sm text-slate-300" data-testid="catalog-summary-rating-note">
          {catalogSummary.ratedGames === 0 ? 'No ratings yet' : `${catalogSummary.ratedGames} rated games`}
        </p>
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>
